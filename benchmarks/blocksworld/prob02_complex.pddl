(define (problem bw-6-blocks)
  (:domain blocksworld)
  (:objects b1 b2 b3 b4 b5 b6)
  (:init
    (ontable b1)
    (on b2 b1)
    (on b3 b2)
    (clear b3)
    (ontable b4)
    (on b5 b4)
    (on b6 b5)
    (clear b6)
    (handempty)
  )
  (:goal
    (and
      (on b1 b2)
      (on b2 b3)
      (on b3 b4)
      (on b4 b5)
      (on b5 b6)
    )
  )
)
